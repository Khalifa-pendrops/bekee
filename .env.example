# ========================================================
# ARUBEKEE COLLECTION - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place production secrets in this file.
# Copy to .env.local for local development.
# ========================================================

# Base application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack (Nigerian Payment Gateway)
# Use pk_test_... and sk_test_... for local testing
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signing_secret

# Store Operations
STORE_TIMEZONE=Africa/Lagos
DEFAULT_CURRENCY=NGN
STORE_WHATSAPP_NUMBER=2348030001234
STORE_PHYSICAL_CITY=Aba
STORE_PHYSICAL_STATE=Abia State

# Transactional Email (Resend or replaceable adapter)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSACTIONAL_FROM_EMAIL=orders@arubekee.com
OWNER_NOTIFICATION_EMAIL=owner@arubekee.com

# Feature Flags & Dev Overrides
ENABLE_DEV_MOCK_CHECKOUT=true

